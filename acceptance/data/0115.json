{
  "version": 1,
  "name": "Noise layers",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 2,
        "hold_ms": 0,
        "decay_ms": 130,
        "attack_curve": "linear",
        "decay_curve": "ease-out"
      }
    },
    "n1": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "inputs.note"
        }
      }
    },
    "n2": {
      "module": "oscillator",
      "inputs": {
        "waveform": "sine",
        "frequency_hz": {
          "ref": "n1.hz"
        },
        "phase_cycles": 0
      }
    },
    "n3": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n2.audio"
        },
        "envelope": {
          "ref": "n0.control"
        },
        "gain": {
          "ref": "inputs.tone_level"
        }
      }
    },
    "n4": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n3.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n0.duration_ms"
        }
      }
    },
    "n5": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 1,
        "hold_ms": 0,
        "decay_ms": {
          "ref": "inputs.noise_decay"
        },
        "attack_curve": "linear",
        "decay_curve": "ease-out"
      }
    },
    "n6": {
      "module": "noise",
      "inputs": {
        "seed": {
          "ref": "inputs.seed"
        }
      }
    },
    "n7": {
      "module": "lowpass",
      "inputs": {
        "audio": {
          "ref": "n6.audio"
        },
        "envelope": {
          "ref": "n5.control"
        },
        "cutoff_hz": {
          "ref": "inputs.noise_cutoff"
        },
        "resonance": 0.707,
        "amount": 0
      }
    },
    "n8": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n7.audio"
        },
        "envelope": {
          "ref": "n5.control"
        },
        "gain": {
          "ref": "inputs.noise_level"
        }
      }
    },
    "n9": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n8.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n5.duration_ms"
        }
      }
    },
    "n10": {
      "module": "mix",
      "inputs": {
        "audio_a": {
          "ref": "n4.audio"
        },
        "audio_b": {
          "ref": "n9.audio"
        },
        "duration_a_ms": {
          "ref": "n4.end_ms"
        },
        "duration_b_ms": {
          "ref": "n9.end_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n10.audio"
    },
    "duration_ms": {
      "ref": "n10.duration_ms"
    }
  },
  "inputs": {
    "note": {
      "label": "Note",
      "type": "note",
      "default": "C5",
      "range": [
        "C4",
        "C6"
      ]
    },
    "tone_level": {
      "label": "Tone level",
      "type": "float",
      "default": 0.12,
      "range": [
        0,
        0.25
      ],
      "step": 0.01
    },
    "noise_level": {
      "label": "Noise level",
      "type": "float",
      "default": 0.18,
      "range": [
        0,
        0.3
      ],
      "step": 0.01
    },
    "noise_decay": {
      "label": "Noise decay",
      "type": "duration",
      "default": 35,
      "unit": "ms",
      "range": [
        5,
        200
      ],
      "step": 5
    },
    "noise_cutoff": {
      "label": "Noise cutoff",
      "type": "float",
      "default": 3000,
      "unit": "Hz",
      "range": [
        200,
        16000
      ],
      "step": 100
    },
    "seed": {
      "label": "Seed",
      "type": "float",
      "default": 1,
      "range": [
        0,
        99
      ],
      "step": 1
    }
  }
}
