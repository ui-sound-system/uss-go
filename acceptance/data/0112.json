{
  "version": 1,
  "name": "envelope",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "text_select",
      "inputs": {
        "selector": {
          "ref": "inputs.attack_curve"
        },
        "match": "ease-in",
        "if_true": "ease-in",
        "if_false": "ease-out"
      }
    },
    "n1": {
      "module": "text_select",
      "inputs": {
        "selector": {
          "ref": "inputs.attack_curve"
        },
        "match": "linear",
        "if_true": "linear",
        "if_false": {
          "ref": "n0.value"
        }
      }
    },
    "n2": {
      "module": "text_select",
      "inputs": {
        "selector": {
          "ref": "inputs.decay_curve"
        },
        "match": "ease-in",
        "if_true": "ease-in",
        "if_false": "ease-out"
      }
    },
    "n3": {
      "module": "text_select",
      "inputs": {
        "selector": {
          "ref": "inputs.decay_curve"
        },
        "match": "linear",
        "if_true": "linear",
        "if_false": {
          "ref": "n2.value"
        }
      }
    },
    "n4": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": {
          "ref": "inputs.attack"
        },
        "hold_ms": {
          "ref": "inputs.hold"
        },
        "decay_ms": {
          "ref": "inputs.decay"
        },
        "attack_curve": {
          "ref": "n1.value"
        },
        "decay_curve": {
          "ref": "n3.value"
        }
      }
    },
    "n5": {
      "module": "note_frequency",
      "inputs": {
        "note": "G4"
      }
    },
    "n6": {
      "module": "oscillator",
      "inputs": {
        "waveform": "sine",
        "frequency_hz": {
          "ref": "n5.hz"
        },
        "phase_cycles": 0
      }
    },
    "n7": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n6.audio"
        },
        "envelope": {
          "ref": "n4.control"
        },
        "gain": 0.15
      }
    },
    "n8": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n7.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n4.duration_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n8.audio"
    },
    "duration_ms": {
      "ref": "n8.end_ms"
    }
  },
  "inputs": {
    "attack": {
      "label": "Attack",
      "type": "duration",
      "default": 100,
      "unit": "ms",
      "range": [
        0,
        500
      ],
      "step": 10
    },
    "hold": {
      "label": "Hold",
      "type": "duration",
      "default": 100,
      "unit": "ms",
      "range": [
        0,
        500
      ],
      "step": 10
    },
    "decay": {
      "label": "Decay",
      "type": "duration",
      "default": 250,
      "unit": "ms",
      "range": [
        20,
        1000
      ],
      "step": 10
    },
    "attack_curve": {
      "label": "Attack curve",
      "type": "choice",
      "default": "linear",
      "choices": [
        "linear",
        "ease-in",
        "ease-out"
      ]
    },
    "decay_curve": {
      "label": "Decay curve",
      "type": "choice",
      "default": "linear",
      "choices": [
        "linear",
        "ease-in",
        "ease-out"
      ]
    }
  }
}
