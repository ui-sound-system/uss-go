{
  "version": 1,
  "name": "filter-envelope-amount",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 10,
        "hold_ms": 1900,
        "decay_ms": 100,
        "attack_curve": "linear",
        "decay_curve": "linear"
      }
    },
    "n1": {
      "module": "note_frequency",
      "inputs": {
        "note": "G3"
      }
    },
    "n2": {
      "module": "oscillator",
      "inputs": {
        "waveform": "saw",
        "frequency_hz": {
          "ref": "n1.hz"
        },
        "phase_cycles": 0
      }
    },
    "n3": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 700,
        "hold_ms": 200,
        "decay_ms": 1000,
        "attack_curve": "linear",
        "decay_curve": "linear"
      }
    },
    "n4": {
      "module": "lowpass",
      "inputs": {
        "audio": {
          "ref": "n2.audio"
        },
        "envelope": {
          "ref": "n3.control"
        },
        "cutoff_hz": 200,
        "resonance": 0.707,
        "amount": {
          "ref": "inputs.amount"
        }
      }
    },
    "n5": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n4.audio"
        },
        "envelope": {
          "ref": "n0.control"
        },
        "gain": 0.15
      }
    },
    "n6": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n5.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n0.duration_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n6.audio"
    },
    "duration_ms": {
      "ref": "n6.end_ms"
    }
  },
  "inputs": {
    "amount": {
      "label": "Amount",
      "type": "float",
      "default": 4,
      "range": [
        0,
        4
      ],
      "step": 1
    }
  }
}
