{
  "version": 1,
  "name": "fm",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 10,
        "hold_ms": 500,
        "decay_ms": 250,
        "attack_curve": "linear",
        "decay_curve": "linear"
      }
    },
    "n1": {
      "module": "note_frequency",
      "inputs": {
        "note": "G3"
      }
    },
    "n2": {
      "module": "fm_oscillator",
      "inputs": {
        "frequency_hz": {
          "ref": "n1.hz"
        },
        "ratio": {
          "ref": "inputs.ratio"
        },
        "index": {
          "ref": "inputs.index"
        }
      }
    },
    "n3": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n2.audio"
        },
        "envelope": {
          "ref": "n0.control"
        },
        "gain": 0.15
      }
    },
    "n4": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n3.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n0.duration_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n4.audio"
    },
    "duration_ms": {
      "ref": "n4.end_ms"
    }
  },
  "inputs": {
    "ratio": {
      "label": "Ratio",
      "type": "float",
      "default": 2,
      "range": [
        0.5,
        8
      ],
      "step": 0.5
    },
    "index": {
      "label": "Index",
      "type": "float",
      "default": 1,
      "range": [
        0,
        8
      ],
      "step": 0.25
    }
  }
}
