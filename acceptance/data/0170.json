        "level": {
          "ref": "inputs.tail_level"
        },
        "curve": {
          "ref": "n1.value"
        }
      }
    },
    "n29": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n28.shape"
        },
        "duration_ms": {
          "ref": "inputs.tail_duration"
        },
        "level": 0,
        "curve": {
          "ref": "n1.value"
        }
      }
    },
    "n30": {
      "module": "envelope_segments",
      "inputs": {
        "segments": {
          "ref": "n29.shape"
        }
      }
    },
    "n31": {
      "module": "lowpass",
      "inputs": {
        "audio": {
          "ref": "n25.audio"
        },
        "envelope": {
          "ref": "n30.control"
        },
        "cutoff_hz": 1000,
        "resonance": 0.707,
        "amount": 2
      }
    },
    "n32": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n31.audio"
        },
        "envelope": {
          "ref": "n18.control"
        },
        "gain": 0.15
      }
    },
    "n33": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n32.audio"
        },
        "start_ms": 20.01,
        "duration_ms": {
          "ref": "n18.duration_ms"
        }
      }
    },
    "n34": {
      "module": "mix",
      "inputs": {
        "audio_a": {
          "ref": "n17.audio"
        },
        "audio_b": {
          "ref": "n33.audio"
        },
        "duration_a_ms": {
          "ref": "n17.end_ms"
        },
        "duration_b_ms": {
          "ref": "n33.end_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n34.audio"
    },
    "duration_ms": {
      "ref": "n34.duration_ms"
    }
  },
  "inputs": {
    "note": {
      "label": "Note",
      "type": "note",
      "default": "C5",
      "range": [
        "C4",
        "C6"
      ]
    },
    "body": {
      "label": "Body",
      "type": "duration",
      "default": 20,
      "unit": "ms",
      "range": [
        0,
        100
      ],
      "step": 5
    },
    "tail_level": {
      "label": "Tail level",
      "type": "float",
      "default": 0.2,
      "range": [
        0,
        0.5
      ],
      "step": 0.05
    },
    "tail_duration": {
      "label": "Tail duration",
      "type": "duration",
      "default": 120,
      "unit": "ms",
      "range": [
        20,
        500
      ],
      "step": 10
    },
    "curvature": {
      "label": "Curvature",
      "type": "choice",
      "default": "ease-out",
      "choices": [
        "linear",
        "ease-in",
        "ease-out"
      ]
    }
  }
