{
  "version": 1,
  "name": "segmented-envelope",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "text_select",
      "inputs": {
        "selector": {
          "ref": "inputs.curvature"
        },
        "match": "ease-in",
        "if_true": "ease-in",
        "if_false": "ease-out"
      }
    },
    "n1": {
      "module": "text_select",
      "inputs": {
        "selector": {
          "ref": "inputs.curvature"
        },
        "match": "linear",
        "if_true": "linear",
        "if_false": {
          "ref": "n0.value"
        }
      }
    },
    "n2": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 10,
        "hold_ms": 0,
        "decay_ms": 200,
        "attack_curve": {
          "ref": "n1.value"
        },
        "decay_curve": "linear"
      }
    },
    "n3": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "inputs.note"
        }
      }
    },
    "n4": {
      "module": "envelope_segment",
      "inputs": {
        "duration_ms": 5,
        "level": 1,
        "curve": "ease-out"
      }
    },
    "n5": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n4.shape"
        },
        "duration_ms": {
          "ref": "inputs.body"
        },
        "level": 1,
        "curve": "linear"
      }
    },
    "n6": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n5.shape"
        },
        "duration_ms": 20,
        "level": {
          "ref": "inputs.tail_level"
        },
        "curve": {
          "ref": "n1.value"
        }
      }
    },
    "n7": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n6.shape"
        },
        "duration_ms": {
          "ref": "inputs.tail_duration"
        },
        "level": 0,
        "curve": {
          "ref": "n1.value"
        }
      }
    },
    "n8": {
      "module": "envelope_segments",
      "inputs": {
        "segments": {
          "ref": "n7.shape"
        }
      }
    },
    "n9": {
      "module": "fm_oscillator",
      "inputs": {
        "frequency_hz": {
          "ref": "n3.hz"
        },
        "ratio": 2,
        "index": 3,
        "envelope": {
          "ref": "n8.control"
        }
      }
    },
    "n10": {
      "module": "envelope_segment",
      "inputs": {
        "duration_ms": 5,
        "level": 1,
        "curve": "ease-out"
      }
    },
    "n11": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n10.shape"
        },
        "duration_ms": {
          "ref": "inputs.body"
        },
        "level": 1,
        "curve": "linear"
      }
    },
    "n12": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n11.shape"
        },
        "duration_ms": 20,
        "level": {
          "ref": "inputs.tail_level"
        },
        "curve": {
          "ref": "n1.value"
        }
      }
    },
    "n13": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n12.shape"
        },
        "duration_ms": {
          "ref": "inputs.tail_duration"
        },
        "level": 0,
        "curve": {
          "ref": "n1.value"
        }
      }
    },
    "n14": {
      "module": "envelope_segments",
      "inputs": {
        "segments": {
          "ref": "n13.shape"
        }
      }
    },
    "n15": {
      "module": "lowpass",
      "inputs": {
        "audio": {
          "ref": "n9.audio"
        },
        "envelope": {
          "ref": "n14.control"
        },
        "cutoff_hz": 1000,
        "resonance": 0.707,
        "amount": 2
      }
    },
    "n16": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n15.audio"
        },
        "envelope": {
          "ref": "n2.control"
        },
        "gain": 0.15
      }
    },
    "n17": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n16.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n2.duration_ms"
        }
      }
    },
    "n18": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 10,
        "hold_ms": 0,
        "decay_ms": 200,
        "attack_curve": {
          "ref": "n1.value"
        },
        "decay_curve": "linear"
      }
    },
    "n19": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "inputs.note"
        }
      }
    },
    "n20": {
      "module": "envelope_segment",
      "inputs": {
        "duration_ms": 5,
        "level": 1,
        "curve": "ease-out"
      }
    },
    "n21": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n20.shape"
        },
        "duration_ms": {
          "ref": "inputs.body"
        },
        "level": 1,
        "curve": "linear"
      }
    },
    "n22": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n21.shape"
        },
        "duration_ms": 20,
        "level": {
          "ref": "inputs.tail_level"
        },
        "curve": {
          "ref": "n1.value"
        }
      }
    },
    "n23": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n22.shape"
        },
        "duration_ms": {
          "ref": "inputs.tail_duration"
        },
        "level": 0,
        "curve": {
          "ref": "n1.value"
        }
      }
    },
    "n24": {
      "module": "envelope_segments",
      "inputs": {
        "segments": {
          "ref": "n23.shape"
        }
      }
    },
    "n25": {
      "module": "fm_oscillator",
      "inputs": {
        "frequency_hz": {
          "ref": "n19.hz"
        },
        "ratio": 2,
        "index": 3,
        "envelope": {
          "ref": "n24.control"
        }
      }
    },
    "n26": {
      "module": "envelope_segment",
      "inputs": {
        "duration_ms": 5,
        "level": 1,
        "curve": "ease-out"
      }
    },
    "n27": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n26.shape"
        },
        "duration_ms": {
          "ref": "inputs.body"
        },
        "level": 1,
        "curve": "linear"
      }
    },
    "n28": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n27.shape"
        },
