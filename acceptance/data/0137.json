{
  "version": 1,
  "name": "segmented-envelope",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_segment",
      "inputs": {
        "duration_ms": 5,
        "level": 1,
        "curve": "ease-out"
      }
    },
    "n1": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n0.shape"
        },
        "duration_ms": {
          "ref": "inputs.body"
        },
        "level": 1,
        "curve": "linear"
      }
    },
    "n2": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n1.shape"
        },
        "duration_ms": 20,
        "level": {
          "ref": "inputs.tail_level"
        },
        "curve": {
          "ref": "inputs.curvature"
        }
      }
    },
    "n3": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n2.shape"
        },
        "duration_ms": {
          "ref": "inputs.tail_duration"
        },
        "level": 0,
        "curve": {
          "ref": "inputs.curvature"
        }
      }
    },
    "n4": {
      "module": "envelope_segments",
      "inputs": {
        "segments": {
          "ref": "n3.shape"
        }
      }
    },
    "n5": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "inputs.note"
        }
      }
    },
    "n6": {
      "module": "oscillator",
      "inputs": {
        "waveform": "sine",
        "frequency_hz": {
          "ref": "n5.hz"
        },
        "phase_cycles": 0
      }
    },
    "n7": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n6.audio"
        },
        "envelope": {
          "ref": "n4.control"
        },
        "gain": 0.15
      }
    },
    "n8": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n7.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n4.duration_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n8.audio"
    },
    "duration_ms": {
      "ref": "n8.end_ms"
    }
  },
  "inputs": {
    "note": {
      "label": "Note",
      "type": "note",
      "default": "C5",
      "range": [
        "C4",
        "C6"
      ]
    },
    "body": {
      "label": "Body",
      "type": "duration",
      "default": 20,
      "unit": "ms",
      "range": [
        0,
        100
      ],
      "step": 5
    },
    "tail_level": {
      "label": "Tail level",
      "type": "float",
      "default": 0.2,
      "range": [
        0,
        0.5
      ],
      "step": 0.05
    },
    "tail_duration": {
      "label": "Tail duration",
      "type": "duration",
      "default": 120,
      "unit": "ms",
      "range": [
        20,
        500
      ],
      "step": 10
    },
    "curvature": {
      "label": "Curvature",
      "type": "float",
      "default": -4,
      "range": [
        -8,
        8
      ],
      "step": 0.5
    }
  }
}
