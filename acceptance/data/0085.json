{
  "version": 1,
  "name": "FM tone",
  "group": "Notification",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "pitch": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "inputs.note"
        }
      }
    },
    "tone": {
      "module": "fm_oscillator",
      "inputs": {
        "frequency_hz": {
          "ref": "pitch.hz"
        },
        "ratio": {
          "ref": "inputs.ratio"
        },
        "index": {
          "ref": "inputs.index"
        },
        "envelope": {
          "ref": "brightness.control"
        }
      }
    },
    "envelope": {
      "module": "envelope_ad",
      "inputs": {
        "attack_ms": 5,
        "decay_ms": {
          "ref": "inputs.decay"
        },
        "curve": "linear"
      }
    },
    "amp": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "tone.audio"
        },
        "envelope": {
          "ref": "envelope.control"
        },
        "gain": {
          "ref": "inputs.level"
        }
      }
    },
    "brightness": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 10,
        "hold_ms": 20,
        "decay_ms": 40,
        "attack_curve": "ease-out",
        "decay_curve": "linear"
      }
    }
  },
  "output": {
    "audio": {
      "ref": "amp.audio"
    },
    "duration_ms": {
      "ref": "envelope.duration_ms"
    }
  },
  "inputs": {
    "note": {
      "label": "Note",
      "type": "note",
      "default": "C5",
      "range": [
        "C4",
        "C6"
      ]
    },
    "ratio": {
      "label": "Ratio",
      "type": "float",
      "default": 2,
      "range": [
        0.5,
        4
      ],
      "step": 0.25
    },
    "index": {
      "label": "Index",
      "type": "float",
      "default": 1.2,
      "range": [
        0,
        3
      ],
      "step": 0.1
    },
    "decay": {
      "label": "Decay",
      "type": "duration",
      "unit": "ms",
      "default": 180,
      "range": [
        60,
        300
      ],
      "step": 5
    },
    "level": {
      "label": "Level",
      "type": "float",
      "default": 0.18,
      "range": [
        0.08,
        0.3
      ],
      "step": 0.01
    }
  }
}
