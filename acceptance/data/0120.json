{
  "version": 1,
  "name": "low-pass-cutoff",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 10,
        "hold_ms": 700,
        "decay_ms": 150,
        "attack_curve": "linear",
        "decay_curve": "linear"
      }
    },
    "n1": {
      "module": "note_frequency",
      "inputs": {
        "note": "G3"
      }
    },
    "n2": {
      "module": "oscillator",
      "inputs": {
        "waveform": "saw",
        "frequency_hz": {
          "ref": "n1.hz"
        },
        "phase_cycles": 0
      }
    },
    "n3": {
      "module": "lowpass",
      "inputs": {
        "audio": {
          "ref": "n2.audio"
        },
        "envelope": {
          "ref": "n0.control"
        },
        "cutoff_hz": {
          "ref": "inputs.cutoff"
        },
        "resonance": 0.707,
        "amount": 0
      }
    },
    "n4": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n3.audio"
        },
        "envelope": {
          "ref": "n0.control"
        },
        "gain": 0.15
      }
    },
    "n5": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n4.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n0.duration_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n5.audio"
    },
    "duration_ms": {
      "ref": "n5.end_ms"
    }
  },
  "inputs": {
    "cutoff": {
      "label": "Cutoff",
      "type": "float",
      "default": 800,
      "unit": "Hz",
      "range": [
        200,
        12000
      ],
      "step": 100
    }
  }
}
