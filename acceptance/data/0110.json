{
  "version": 1,
  "name": "choices",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 3,
        "hold_ms": 10,
        "decay_ms": 60,
        "attack_curve": "linear",
        "decay_curve": "linear"
      }
    },
    "n1": {
      "module": "note_frequency",
      "inputs": {
        "note": "C4"
      }
    },
    "n2": {
      "module": "oscillator",
      "inputs": {
        "waveform": {
          "ref": "inputs.waveform"
        },
        "frequency_hz": {
          "ref": "n1.hz"
        },
        "phase_cycles": 0
      }
    },
    "n3": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n2.audio"
        },
        "envelope": {
          "ref": "n0.control"
        },
        "gain": 0.12
      }
    },
    "n4": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n3.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n0.duration_ms"
        }
      }
    },
    "n5": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 3,
        "hold_ms": 10,
        "decay_ms": 60,
        "attack_curve": "linear",
        "decay_curve": "linear"
      }
    },
    "n6": {
      "module": "number_select",
      "inputs": {
        "selector": {
          "ref": "inputs.direction"
        },
        "match": "up",
        "if_true": 7,
        "if_false": -7
      }
    },
    "n7": {
      "module": "transpose",
      "inputs": {
        "note": "C4",
        "semitones": {
          "ref": "n6.value"
        }
      }
    },
    "n8": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "n7.note"
        }
      }
    },
    "n9": {
      "module": "oscillator",
      "inputs": {
        "waveform": {
          "ref": "inputs.waveform"
        },
        "frequency_hz": {
          "ref": "n8.hz"
        },
        "phase_cycles": 0
      }
    },
    "n10": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n9.audio"
        },
        "envelope": {
          "ref": "n5.control"
        },
        "gain": 0.12
      }
    },
    "n11": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n10.audio"
        },
        "start_ms": 120,
        "duration_ms": {
          "ref": "n5.duration_ms"
        }
      }
    },
    "n12": {
      "module": "mix",
      "inputs": {
        "audio_a": {
          "ref": "n4.audio"
        },
        "audio_b": {
          "ref": "n11.audio"
        },
        "duration_a_ms": {
          "ref": "n4.end_ms"
        },
        "duration_b_ms": {
          "ref": "n11.end_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n12.audio"
    },
    "duration_ms": {
      "ref": "n12.duration_ms"
    }
  },
  "inputs": {
    "direction": {
      "label": "Direction",
      "type": "choice",
      "default": "up",
      "choices": [
        "up",
        "down"
      ]
    },
    "waveform": {
      "label": "Waveform",
      "type": "choice",
      "default": "sine",
      "choices": [
        "sine",
        "triangle",
        "saw"
      ]
    }
  }
}
