{
  "version": 1,
  "name": "Expression relations",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 3,
        "hold_ms": 8,
        "decay_ms": 10,
        "attack_curve": "linear",
        "decay_curve": "linear"
      }
    },
    "n1": {
      "module": "note_frequency",
      "inputs": {
        "note": "C4"
      }
    },
    "n2": {
      "module": "oscillator",
      "inputs": {
        "waveform": "sine",
        "frequency_hz": {
          "ref": "n1.hz"
        },
        "phase_cycles": 0
      }
    },
    "n3": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n2.audio"
        },
        "envelope": {
          "ref": "n0.control"
        },
        "gain": 0.15
      }
    },
    "n4": {
      "module": "duration_subtract",
      "inputs": {
        "a": {
          "ref": "inputs.length"
        },
        "b": 250
      }
    },
    "n5": {
      "module": "duration_multiply",
      "inputs": {
        "a": {
          "ref": "n4.value"
        },
        "b": -1
      }
    },
    "n6": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n3.audio"
        },
        "start_ms": {
          "ref": "n5.value"
        },
        "duration_ms": {
          "ref": "n0.duration_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n6.audio"
    },
    "duration_ms": {
      "ref": "n6.end_ms"
    }
  },
  "inputs": {
    "length": {
      "label": "Length",
      "type": "duration",
      "default": 100,
      "unit": "ms",
      "range": [
        50,
        200
      ],
      "step": 10
    },
    "factor": {
      "label": "Factor",
      "type": "float",
      "default": 0.3,
      "range": [
        0.1,
        0.5
      ],
      "step": 0.1
    }
  }
}
