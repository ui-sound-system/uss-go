{
  "version": 1,
  "name": "unison",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 5,
        "hold_ms": {
          "ref": "inputs.hold"
        },
        "decay_ms": {
          "ref": "inputs.decay"
        },
        "attack_curve": "linear",
        "decay_curve": "ease-out"
      }
    },
    "n1": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "inputs.note"
        }
      }
    },
    "n2": {
      "module": "unison_oscillator",
      "inputs": {
        "waveform": "sine",
        "frequency_hz": {
          "ref": "n1.hz"
        },
        "phase_cycles": 0,
        "voices": 3,
        "spread_cents": {
          "ref": "inputs.unison"
        }
      }
    },
    "n3": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n2.audio"
        },
        "envelope": {
          "ref": "n0.control"
        },
        "gain": 0.15
      }
    },
    "n4": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n3.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n0.duration_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n4.audio"
    },
    "duration_ms": {
      "ref": "n4.end_ms"
    }
  },
  "inputs": {
    "note": {
      "label": "Note",
      "type": "note",
      "default": "C5",
      "range": [
        "C3",
        "C7"
      ]
    },
    "hold": {
      "label": "Hold",
      "type": "duration",
      "default": 20,
      "unit": "ms",
      "range": [
        20,
        40
      ],
      "step": 2
    },
    "decay": {
      "label": "Decay",
      "type": "duration",
      "default": 40,
      "unit": "ms",
      "range": [
        20,
        50
      ],
      "step": 5
    },
    "unison": {
      "label": "Unison",
      "type": "float",
      "default": 30,
      "unit": "ct",
      "range": [
        0,
        1200
      ],
      "step": 10
    }
  }
}
