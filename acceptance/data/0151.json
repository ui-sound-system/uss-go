{
  "version": 1,
  "name": "Shared room parity",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 3,
        "hold_ms": 0,
        "decay_ms": 100,
        "attack_curve": "linear",
        "decay_curve": "linear"
      }
    },
    "n1": {
      "module": "note_frequency",
      "inputs": {
        "note": "C4"
      }
    },
    "n2": {
      "module": "oscillator",
      "inputs": {
        "waveform": "sine",
        "frequency_hz": {
          "ref": "n1.hz"
        },
        "phase_cycles": 0
      }
    },
    "n3": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n2.audio"
        },
        "envelope": {
          "ref": "n0.control"
        },
        "gain": 0
      }
    },
    "n4": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n3.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n0.duration_ms"
        }
      }
    },
    "n5": {
      "module": "audio_gain",
      "inputs": {
        "audio": {
          "ref": "n4.audio"
        },
        "duration_ms": {
          "ref": "n4.end_ms"
        },
        "gain": 1
      }
    },
    "n6": {
      "module": "reverb",
      "inputs": {
        "audio": {
          "ref": "n5.audio"
        },
        "duration_ms": {
          "ref": "n5.duration_ms"
        },
        "pre_delay_ms": 10,
        "room_size": 0.2,
        "decay_ms": 100,
        "damping": 0.4,
        "wet": 1
      }
    },
    "n7": {
      "module": "mix",
      "inputs": {
        "audio_a": {
          "ref": "n4.audio"
        },
        "audio_b": {
          "ref": "n6.audio"
        },
        "duration_a_ms": {
          "ref": "n4.end_ms"
        },
        "duration_b_ms": {
          "ref": "n6.duration_ms"
        }
      }
    },
    "n8": {
      "module": "trim",
      "inputs": {
        "audio": {
          "ref": "n7.audio"
        },
        "duration_ms": {
          "ref": "n7.duration_ms"
        },
        "keep_ms": {
          "ref": "n4.end_ms"
        },
        "enabled": 1,
        "threshold_db": 60
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n8.audio"
    },
    "duration_ms": {
      "ref": "n8.duration_ms"
    }
  },
  "inputs": {
    "send": {
      "label": "Send",
      "type": "float",
      "default": 0.5,
      "range": [
        0,
        1
      ],
      "step": 0.1
    }
  }
}
