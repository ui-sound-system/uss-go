{
  "version": 1,
  "name": "fm-brightness",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 2,
        "hold_ms": 0,
        "decay_ms": {
          "ref": "inputs.tone_decay"
        },
        "attack_curve": "linear",
        "decay_curve": "ease-out"
      }
    },
    "n1": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "inputs.note"
        }
      }
    },
    "n2": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": {
          "ref": "inputs.brightness_attack"
        },
        "hold_ms": 0,
        "decay_ms": {
          "ref": "inputs.brightness_decay"
        },
        "attack_curve": "linear",
        "decay_curve": "ease-out"
      }
    },
    "n3": {
      "module": "fm_oscillator",
      "inputs": {
        "frequency_hz": {
          "ref": "n1.hz"
        },
        "ratio": {
          "ref": "inputs.ratio"
        },
        "index": {
          "ref": "inputs.index"
        },
        "envelope": {
          "ref": "n2.control"
        }
      }
    },
    "n4": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n3.audio"
        },
        "envelope": {
          "ref": "n0.control"
        },
        "gain": 0.15
      }
    },
    "n5": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n4.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n0.duration_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n5.audio"
    },
    "duration_ms": {
      "ref": "n5.end_ms"
    }
  },
  "inputs": {
    "note": {
      "label": "Note",
      "type": "note",
      "default": "A3",
      "range": [
        "C3",
        "C5"
      ]
    },
    "ratio": {
      "label": "Ratio",
      "type": "float",
      "default": 3,
      "range": [
        0.5,
        4
      ],
      "step": 0.5
    },
    "index": {
      "label": "Index",
      "type": "float",
      "default": 2,
      "range": [
        0,
        8
      ],
      "step": 0.25
    },
    "brightness_attack": {
      "label": "Brightness attack",
      "type": "duration",
      "default": 80,
      "unit": "ms",
      "range": [
        0,
        120
      ],
      "step": 1
    },
    "brightness_decay": {
      "label": "Brightness decay",
      "type": "duration",
      "default": 120,
      "unit": "ms",
      "range": [
        20,
        500
      ],
      "step": 10
    },
    "tone_decay": {
      "label": "Tone decay",
      "type": "duration",
      "default": 560,
      "unit": "ms",
      "range": [
        200,
        1000
      ],
      "step": 10
    }
  }
}
