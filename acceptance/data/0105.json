{
  "version": 1,
  "name": "tick",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": {
          "ref": "inputs.attack"
        },
        "hold_ms": 0,
        "decay_ms": {
          "ref": "inputs.decay"
        },
        "attack_curve": -1,
        "decay_curve": -5
      }
    },
    "n1": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "inputs.note"
        }
      }
    },
    "n2": {
      "module": "oscillator",
      "inputs": {
        "waveform": {
          "ref": "inputs.waveform"
        },
        "frequency_hz": {
          "ref": "n1.hz"
        },
        "phase_cycles": 0
      }
    },
    "n3": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n2.audio"
        },
        "envelope": {
          "ref": "n0.control"
        },
        "gain": {
          "ref": "inputs.level"
        }
      }
    },
    "n4": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n3.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n0.duration_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n4.audio"
    },
    "duration_ms": {
      "ref": "n4.end_ms"
    }
  },
  "inputs": {
    "note": {
      "label": "Oscillator pitch",
      "type": "note",
      "default": "A3",
      "range": [
        "C2",
        "C5"
      ]
    },
    "waveform": {
      "label": "Waveform",
      "type": "choice",
      "default": "square",
      "choices": [
        "sine",
        "triangle",
        "saw",
        "square"
      ]
    },
    "attack": {
      "label": "Attack",
      "type": "duration",
      "default": 2,
      "unit": "ms",
      "range": [
        0,
        5
      ],
      "step": 0.5
    },
    "decay": {
      "label": "Decay",
      "type": "duration",
      "default": 10,
      "unit": "ms",
      "range": [
        1,
        30
      ],
      "step": 1
    },
    "level": {
      "label": "Level",
      "type": "float",
      "default": 0.05,
      "range": [
        0,
        0.1
      ],
      "step": 0.001
    }
  }
}
