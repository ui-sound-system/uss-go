{
  "version": 1,
  "name": "pitch-sweep",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 10,
        "hold_ms": 500,
        "decay_ms": 250,
        "attack_curve": "linear",
        "decay_curve": "linear"
      }
    },
    "n1": {
      "module": "note_frequency",
      "inputs": {
        "note": "G3"
      }
    },
    "n2": {
      "module": "pitch_sweep",
      "inputs": {
        "frequency_hz": {
          "ref": "n1.hz"
        },
        "semitones": {
          "ref": "inputs.sweep"
        },
        "duration_ms": {
          "ref": "inputs.length"
        }
      }
    },
    "n3": {
      "module": "oscillator",
      "inputs": {
        "waveform": "sine",
        "phase_cycles": 0,
        "phase": {
          "ref": "n2.phase"
        }
      }
    },
    "n4": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n3.audio"
        },
        "envelope": {
          "ref": "n0.control"
        },
        "gain": 0.15
      }
    },
    "n5": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n4.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n0.duration_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n5.audio"
    },
    "duration_ms": {
      "ref": "n5.end_ms"
    }
  },
  "inputs": {
    "sweep": {
      "label": "Sweep",
      "type": "float",
      "default": 12,
      "range": [
        -12,
        12
      ],
      "step": 1
    },
    "length": {
      "label": "Length",
      "type": "duration",
      "default": 150,
      "unit": "ms",
      "range": [
        20,
        500
      ],
      "step": 10
    }
  }
}
