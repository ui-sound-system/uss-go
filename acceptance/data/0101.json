{
  "version": 1,
  "name": "high-tinitus",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": {
          "ref": "inputs.attack"
        },
        "hold_ms": 5,
        "decay_ms": {
          "ref": "inputs.body"
        },
        "attack_curve": 2,
        "decay_curve": -2
      }
    },
    "n1": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "inputs.note"
        }
      }
    },
    "n2": {
      "module": "oscillator",
      "inputs": {
        "waveform": "sine",
        "frequency_hz": {
          "ref": "n1.hz"
        },
        "phase_cycles": 0
      }
    },
    "n3": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n2.audio"
        },
        "envelope": {
          "ref": "n0.control"
        },
        "gain": {
          "ref": "inputs.level"
        }
      }
    },
    "n4": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n3.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n0.duration_ms"
        }
      }
    },
    "n5": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": {
          "ref": "inputs.attack"
        },
        "hold_ms": 5,
        "decay_ms": {
          "ref": "inputs.body"
        },
        "attack_curve": "linear",
        "decay_curve": -2
      }
    },
    "n6": {
      "module": "transpose",
      "inputs": {
        "note": {
          "ref": "inputs.note"
        },
        "semitones": 1
      }
    },
    "n7": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "n6.note"
        }
      }
    },
    "n8": {
      "module": "oscillator",
      "inputs": {
        "waveform": "saw",
        "frequency_hz": {
          "ref": "n7.hz"
        },
        "phase_cycles": 0
      }
    },
    "n9": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n8.audio"
        },
        "envelope": {
          "ref": "n5.control"
        },
        "gain": {
          "ref": "inputs.accent"
        }
      }
    },
    "n10": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n9.audio"
        },
        "start_ms": 10,
        "duration_ms": {
          "ref": "n5.duration_ms"
        }
      }
    },
    "n11": {
      "module": "mix",
      "inputs": {
        "audio_a": {
          "ref": "n4.audio"
        },
        "audio_b": {
          "ref": "n10.audio"
        },
        "duration_a_ms": {
          "ref": "n4.end_ms"
        },
        "duration_b_ms": {
          "ref": "n10.end_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n11.audio"
    },
    "duration_ms": {
      "ref": "n11.duration_ms"
    }
  },
  "inputs": {
    "note": {
      "label": "Note",
      "type": "note",
      "default": "E8",
      "range": [
        "C7",
        "A8"
      ]
    },
    "attack": {
      "label": "Attack",
      "type": "duration",
      "default": 5,
      "unit": "ms",
      "range": [
        2,
        20
      ],
      "step": 1
    },
    "body": {
      "label": "Decay duration",
      "type": "duration",
      "default": 45,
      "unit": "ms",
      "range": [
        10,
        80
      ],
      "step": 5
    },
    "accent": {
      "label": "Accent",
      "type": "float",
      "default": 0.02,
      "range": [
        0,
        0.05
      ],
      "step": 0.005
    },
    "level": {
      "label": "Level",
      "type": "float",
      "default": 0.05,
      "range": [
        0,
        0.2
      ],
      "step": 0.005
    }
  }
}
