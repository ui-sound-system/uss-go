{
  "version": 1,
  "name": "segmented-envelope",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_segment",
      "inputs": {
        "duration_ms": 0,
        "level": 1,
        "curve": "linear"
      }
    },
    "n1": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n0.shape"
        },
        "duration_ms": 20,
        "level": 1,
        "curve": "linear"
      }
    },
    "n2": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n1.shape"
        },
        "duration_ms": 0,
        "level": 0.2,
        "curve": "linear"
      }
    },
    "n3": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n2.shape"
        },
        "duration_ms": 20,
        "level": 0.2,
        "curve": "linear"
      }
    },
    "n4": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n3.shape"
        },
        "duration_ms": 0,
        "level": 0,
        "curve": "linear"
      }
    },
    "n5": {
      "module": "envelope_segments",
      "inputs": {
        "segments": {
          "ref": "n4.shape"
        }
      }
    },
    "n6": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "inputs.note"
        }
      }
    },
    "n7": {
      "module": "envelope_segment",
      "inputs": {
        "duration_ms": 5,
        "level": 1,
        "curve": "ease-out"
      }
    },
    "n8": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n7.shape"
        },
        "duration_ms": {
          "ref": "inputs.body"
        },
        "level": 1,
        "curve": "linear"
      }
    },
    "n9": {
      "module": "text_select",
      "inputs": {
        "selector": {
          "ref": "inputs.curvature"
        },
        "match": "ease-in",
        "if_true": "ease-in",
        "if_false": "ease-out"
      }
    },
    "n10": {
      "module": "text_select",
      "inputs": {
        "selector": {
          "ref": "inputs.curvature"
        },
        "match": "linear",
        "if_true": "linear",
        "if_false": {
          "ref": "n9.value"
        }
      }
    },
    "n11": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n8.shape"
        },
        "duration_ms": 20,
        "level": {
          "ref": "inputs.tail_level"
        },
        "curve": {
          "ref": "n10.value"
        }
      }
    },
    "n12": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n11.shape"
        },
        "duration_ms": {
          "ref": "inputs.tail_duration"
        },
        "level": 0,
        "curve": {
          "ref": "n10.value"
        }
      }
    },
    "n13": {
      "module": "envelope_segments",
      "inputs": {
        "segments": {
          "ref": "n12.shape"
        }
      }
    },
    "n14": {
      "module": "fm_oscillator",
      "inputs": {
        "frequency_hz": {
          "ref": "n6.hz"
        },
        "ratio": 2,
        "index": 3,
        "envelope": {
          "ref": "n13.control"
        }
      }
    },
    "n15": {
      "module": "envelope_segment",
      "inputs": {
        "duration_ms": 5,
        "level": 1,
        "curve": "ease-out"
      }
    },
    "n16": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n15.shape"
        },
        "duration_ms": {
          "ref": "inputs.body"
        },
        "level": 1,
        "curve": "linear"
      }
    },
    "n17": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n16.shape"
        },
        "duration_ms": 20,
        "level": {
          "ref": "inputs.tail_level"
        },
        "curve": {
          "ref": "n10.value"
        }
      }
    },
    "n18": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n17.shape"
        },
        "duration_ms": {
          "ref": "inputs.tail_duration"
        },
        "level": 0,
        "curve": {
          "ref": "n10.value"
        }
      }
    },
    "n19": {
      "module": "envelope_segments",
      "inputs": {
        "segments": {
          "ref": "n18.shape"
        }
      }
    },
    "n20": {
      "module": "lowpass",
      "inputs": {
        "audio": {
          "ref": "n14.audio"
        },
        "envelope": {
          "ref": "n19.control"
        },
        "cutoff_hz": 1000,
        "resonance": 0.707,
        "amount": 2
      }
    },
    "n21": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n20.audio"
        },
        "envelope": {
          "ref": "n5.control"
        },
        "gain": 0.15
      }
    },
    "n22": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n21.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n5.duration_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n22.audio"
    },
    "duration_ms": {
      "ref": "n22.end_ms"
    }
  },
  "inputs": {
    "note": {
      "label": "Note",
      "type": "note",
      "default": "C5",
      "range": [
        "C4",
        "C6"
      ]
    },
    "body": {
      "label": "Body",
      "type": "duration",
      "default": 20,
      "unit": "ms",
      "range": [
        0,
        100
      ],
      "step": 5
    },
    "tail_level": {
      "label": "Tail level",
      "type": "float",
      "default": 0.2,
      "range": [
        0,
        0.5
      ],
      "step": 0.05
    },
    "tail_duration": {
      "label": "Tail duration",
      "type": "duration",
      "default": 120,
      "unit": "ms",
      "range": [
        20,
        500
      ],
      "step": 10
    },
    "curvature": {
      "label": "Curvature",
      "type": "choice",
      "default": "ease-out",
      "choices": [
        "linear",
        "ease-in",
        "ease-out"
      ]
    }
  }
}
